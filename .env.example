# Copy to .env and fill in. Defaults line up with docker-compose.yml.

NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# --- Database (Postgres + pgvector) ---
DB_HOST=localhost
DB_PORT=54322
DB_NAME=groupchat
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Applies model changes straight to the database at boot. Fine while there is
# no data worth keeping; switch to migrations before that changes.
DB_SYNC=true
# Hosted Postgres (Render, Neon, Supabase) needs TLS; local Docker does not.
DB_SSL=false

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Encrypts each user's own LLM API keys at rest (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=

# --- AWS S3 (file sharing) ---
BUCKET_NAME=
IAM_ACCESS_KEY=
IAM_SECRET_KEY=
AWS_REGION=eu-central-1

# --- Email (password reset via Brevo/SendinBlue) ---
SIB_API_KEY=
MAIL_SENDER_EMAIL=no-reply@groupchat.local
MAIL_SENDER_NAME=GroupChat

# --- LLM layer (Phase 2). Provider is swappable — see Decision 7. ---
# This is the SERVER-WIDE default — always tried LAST, after each user's own
# BYOK credentials (see /api/llm-credentials: every user can add their own
# keys across providers, tried in priority order). Its job is to give a
# brand-new user with no keys of their own something that still works.
# LLM_PROVIDER=ollama | openai-compatible
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
# ollama
OLLAMA_BASE_URL=http://localhost:11434
# openai-compatible (Groq, OpenRouter, ...)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
